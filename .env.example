APP_NAME=RemoteMatch
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_DB=remotematch
POSTGRES_USER=remotematch
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://remotematch:change_me@localhost:5432/remotematch

SESSION_SECRET=replace_with_a_random_value_of_at_least_32_characters
SESSION_COOKIE_NAME=remotematch_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

JOB_SOURCE_ARBEITNOW_ENABLED=true
JOB_SOURCE_GREENHOUSE_ENABLED=true
JOB_SOURCE_HIMALAYAS_ENABLED=true
JOB_SOURCE_JOBICY_ENABLED=true
JOB_SOURCE_REMOTEOK_ENABLED=true